{
  "name": "docbox",
  "version": "0.4.2",
  "description": "本地文档与图像工作台：全类型文件预览、账户角色与模块授权、15 项文档能力、23 项原生 PDF、18 项音视频、16 项浏览器本机发起的网络体检、SSH/Telnet 网页终端、离线 OCR（中英混排 + 条码/二维码）与 Whisper 转写、视频网站解析下载。",
  "main": "server.mjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --max-old-space-size=8192 --max-semi-space-size=32 server.mjs",
    "dev": "node --watch --max-old-space-size=8192 --max-semi-space-size=32 server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/smoke.mjs",
    "prestart": "node scripts/fix-sharp.mjs",
    "predev": "node scripts/fix-sharp.mjs",
    "tools:fixtures": "node scripts/tools-fixtures.mjs",
    "tools:check": "node scripts/tools-check.mjs"
  },
  "keywords": [
    "pdf",
    "image",
    "audio",
    "video",
    "ffmpeg",
    "watermark",
    "ocr",
    "network",
    "mysql",
    "local-first"
  ],
  "author": "DocBox",
  "license": "MIT",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@napi-rs/canvas": "^1.0.11",
    "@pdf-lib/fontkit": "^1.1.1",
    "@roamhq/wrtc": "^0.10.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "sherpa-onnx-node": "^1.13.8",
    "ssh2": "^1.17.0",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5",
    "zxing-wasm": "^2.0.1"
  }
}
