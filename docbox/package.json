{
  "name": "docbox",
  "version": "0.1.3",
  "description": "本地文档与图像工作台：账户角色与模块授权、15 项文档能力（Word/Excel/PPT/Markdown/公文排版）、音视频预览、7 套工作水印、证件照排版、23 项原生 PDF、18 项音视频、16 项网络体检、离线 OCR。",
  "main": "server.mjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --max-old-space-size=1536 --max-semi-space-size=16 server.mjs",
    "dev": "node --watch --max-old-space-size=1536 --max-semi-space-size=16 server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/smoke.mjs"
  },
  "keywords": [
    "pdf",
    "image",
    "audio",
    "video",
    "ffmpeg",
    "watermark",
    "ocr",
    "network",
    "mysql",
    "local-first"
  ],
  "author": "DocBox",
  "license": "MIT",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@napi-rs/canvas": "^1.0.11",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  }
}
